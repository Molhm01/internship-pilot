// Prisma schema for Internship Pilot.
//
// PostgreSQL in every environment. Prisma cannot take its provider from an
// environment variable, so "SQLite locally, Postgres in production" would mean
// two schema files and two migration histories drifting apart — the exact hack
// this project would rather not carry. Local development instead runs a real
// Postgres (`npx prisma dev` starts one with no Docker and no install), so the
// database a feature is written against is the database it ships on.
//
// The original SQLite migration history is preserved under
// prisma/migrations-sqlite-archive/ and prisma/README.md documents how to move
// an existing dev.db across.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts, which reads
// DATABASE_URL from the environment. Nothing here is a credential.
datasource db {
  provider = "postgresql"
}

// One row per fact extracted from the user's resume by the local AI model.
// Nothing in here is ever shown as "true" until the user approves it.
model ResumeFact {
  id        String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // education | gpa | graduationDate | coursework | skill | project | experience | activity
  content   String // human-readable text of the fact, e.g. "Python (used in 2 projects)"
  detail    String? // optional longer context pulled from the resume (dates, org, description)
  status    String   @default("pending") // pending | approved | edited | rejected
  source    String   @default("ai") // ai | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A resume or cover-letter PDF the user uploaded. The original file lives on
// disk under data/resumes/ (path stored in storagePath); this row tracks its
// extracted text and lets the Profile/Documents pages show filename/size/
// page count/status.
model ResumeDocument {
  id            String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   @default("resume") // resume | coverLetter
  filename      String
  sizeBytes     Int
  pageCount     Int
  storagePath   String
  extractedText String
  status        String // "ok" | "scanned"
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Milestone 5: a reusable, pre-approved resume bullet. Generated once from
// approved ResumeFacts (never freely rewritten per job) — every bullet cites
// the exact fact ids it's grounded in, so per-job document generation only
// ever SELECTS from this library rather than writing new prose, which is
// what makes "never invent a sentence" structurally true rather than a
// hopeful instruction to the model.
model ResumeBullet {
  id        String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // education | skill | project | experience | activity
  text      String
  factIds   String // JSON array of ResumeFact ids this bullet is grounded in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per resume/cover-letter PDF generated for a specific job. Never
// shared between jobs — storagePath always lives under a per-job folder.
model GeneratedDocument {
  id                    String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                 String
  job                   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type                  String // resume | coverLetter
  version               Int      @default(1)
  storagePath           String // PDF location under data/generated/<jobId>/
  typstSourcePath       String?
  qaStatus              String // pass | fail
  qaIssues              String? // JSON array of strings
  keywordClassification String? // JSON: {supported,confirmationRequired,developmentGap,unsupported}
  tailoringStatus       String? // TAILORED_WITH_SUPPORTED_CHANGES | MASTER_UNCHANGED_NO_SUPPORTED_IMPROVEMENT | NOT_TAILORED_NO_JOB_DESCRIPTION
  tailoringAudit        String? // JSON audit with scores, changes, evidence, and intentionally omitted requirements
  identityVerified      Boolean  @default(false)
  bulletIdsUsed         String? // JSON array of ResumeBullet ids actually included
  matchResultId         String? // which MatchResult this was generated from
  documentFingerprint   String? // deterministic job/profile/template/policy freshness fingerprint
  createdAt             DateTime @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([userId, jobId])
  @@index([userId, jobId, documentFingerprint])
}

// Locked application profile — the one place identity/contact answers live
// for resume headers now, and Milestone 6's application-form autofill later.
// Singleton row (id is always "default").
model ApplicationProfile {
  id                         String   @id @default("default")
  fullName                   String? // legal name
  // Split legal name. `fullName` stays as-is for everything that already reads
  // it; these are what an application form actually asks for, and a form that
  // wants "Legal first name" can never be answered by splitting a display name
  // on whitespace without guessing where a middle name ends.
  legalFirstName             String?
  legalMiddleName            String?
  // "I have no middle name" is an answer; a null middle name is not. Forms ask
  // both questions and only this can answer the second.
  noMiddleName               Boolean?
  legalLastName              String?
  suffix                     String?
  preferredName              String?
  pronouns                   String?
  email                      String?
  alternateEmail             String?
  phone                      String?
  phoneCountryCode           String?
  linkedin                   String?
  github                     String?
  website                    String?
  portfolio                  String?
  school                     String? // current school (e.g. NJIT)
  previousSchool             String? // e.g. Stevens, if transferred — reference only, not deeply wired into per-field autofill
  addressStreet              String?
  // A real second address line. Without one the agent had nothing to put in an
  // employer's "Address Line 2" box, and copied line 1 into it.
  addressLine2               String?
  addressCity                String?
  addressState               String?
  addressZip                 String?
  countryOfResidence         String? // distinct from citizenship/work authorization
  willingToRelocate          Boolean?
  locationPreferences        String? // JSON array of strings
  internshipTermAvailability String? // e.g. "Summer 2027"
  salaryAnswerPreference     String? // e.g. "Negotiable", or a specific figure — used verbatim only
  // Milestone 6: these are ALL left null until the user explicitly sets
  // them. Null means "unknown" — the application agent must stop for
  // NEEDS_USER_ACTION on any question in that category rather than guess,
  // per the spec's citizenship/clearance/sponsorship/EEO stopping rules.
  workAuthorization          String? // e.g. "U.S. Citizen", "Green Card", "F-1 OPT/CPT" — free text, used verbatim only
  requiresSponsorship        Boolean?
  clearanceEligible          Boolean?
  eeoGender                  String?
  eeoRaceEthnicity           String?
  eeoVeteranStatus           String?
  eeoDisabilityStatus        String?
  // Structured education. Previously only `school` existed and everything else
  // lived in ResumeFact free text, which an application form cannot be filled
  // from: "Degree type" needs a degree, not a sentence mentioning one.
  degreeType                 String? // e.g. "Bachelor's Degree"
  educationLevel             String? // e.g. "Undergraduate"
  major                      String?
  minor                      String?
  educationStartDate         String? // YYYY-MM
  graduationDate             String? // YYYY-MM
  gpa                        String? // stored verbatim as the user wrote it
  gpaScale                   String?
  relevantCoursework         String? // JSON array of strings
  // Remaining application facts a form asks for that the profile could not answer.
  remotePreference           String? // remote | hybrid | onsite | no_preference
  earliestStartDate          String? // YYYY-MM-DD
  hasDriversLicense          Boolean?
  meetsMinimumAge            Boolean?
  referralSource             String? // explicit answer to "How did you hear about us?"
  // Account-creation preferences. No password is ever stored here; see the
  // extension's encrypted credential vault.
  applicationEmail           String? // the address used to register on employer sites
  preferredUsername          String?
  wantsAccountCreationHelp   Boolean?
  // prefer_guest | create_when_required | always_ask. Null means the user has
  // not chosen, and the extension asks rather than assuming.
  employerPortalStrategy     String?
  // The closest metropolitan area, which an ATS often asks for and which is
  // usually not the city of residence.
  metroRegion                String?
  // Which stored link answers a form that offers exactly one "Website" box:
  // linkedin | github | portfolio | website. Chosen, never inferred by order.
  preferredWebsiteField      String?
  // Distinct from degreeType, which is what the applicant is currently pursuing.
  highestDegreeAwarded       String?
  // negotiable | specific | decline — plus the figure, when there is one.
  salaryStrategy             String?
  salaryMinimum              String?
  // Opt-in only. Null is not consent.
  marketingTextConsent       Boolean?
  // The clearance answer in words; clearanceEligible remains the boolean.
  securityClearanceStatus    String?
  updatedAt                  DateTime @updatedAt
}

// What the applicant knows about one employer.
//
// Per company, never profile-wide: "have you worked here before" answered from
// a global default would be a fabrication. No row means the user has told us
// nothing about this company, and the agent must ask rather than answer.
model CompanyRelationshipFact {
  id          String  @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lower-cased, whitespace-collapsed company name. Unique PER USER: what one
  /// applicant knows about an employer says nothing about what another does.
  companyKey  String
  /// As the user typed it.
  companyName String

  previouslyEmployed    Boolean?
  previouslyInterviewed Boolean?
  previouslyApplied     Boolean?
  familyMemberEmployed  Boolean?
  hasReferral           Boolean?
  referralName          String?
  referralEmail         String?
  referralRelationship  String?
  /// JSON object of company-specific answer overrides, keyed by question text.
  overrides             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyKey])
  @@index([userId])
}

// The Company Watchlist (Milestone 1 / 2): every employer whose official
// career page we know about and check on a schedule. Seeded with named
// employers plus anything discovered via nearby-firm search; fully
// expandable — never hardcoded to a fixed list.
model Company {
  id                    String    @id @default(cuid())
  name                  String    @unique
  industry              String?
  website               String?
  careersUrl            String?
  atsType               String? // greenhouse | lever | ashby | smartrecruiters | workday | icims | taleo | successfactors | custom | unknown
  atsIdentifier         String? // board slug / tenant / company id for the ATS, when known
  locations             String? // JSON array of strings
  priority              String    @default("standard") // priority | standard | low
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime?
  activeInternshipCount Int       @default(0)
  source                String    @default("seed") // csv | manual | intern-list-approved | seed | discovered (legacy)
  monitoringStatus      String    @default("active") // active | paused
  lastCheckStatus       String? // success | error | unsupported
  lastCheckError        String?
  consecutiveFailures   Int       @default(0) // drives exponential backoff on nextCheckAt
  lastETag              String? // conditional-request support for the generic careers-page scan
  lastModified          String?
  contentHash           String? // hash of the last-seen careers-page content — skip reprocessing when unchanged even without ETag/Last-Modified support
  boardSnapshot         String? // JSON source-job-id array from the last successful complete-enough board poll
  lastSuccessfulBoardAt DateTime?
  lastBoardQueryMs      Int?
  // Live configuration truth. An ATS enum alone never makes a board usable.
  // VALIDATED | STALE | MALFORMED | UNTESTED | UNSUPPORTED | CUSTOM
  atsConfigState        String    @default("UNTESTED")
  atsConfigCheckedAt    DateTime?
  atsValidatedAt        DateTime?
  atsConfigErrorCode    String?
  atsConfigEvidence     String? // JSON containing bounded-probe facts, never credentials
  // A = recent relevant posting, B = historical relevant posting, C = none yet.
  engineeringActivityTier String  @default("C")
  lastEngineeringInternshipAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Strict discovery boundary: the scheduler only actively checks a company
  // when this is true. True for rows sourced from the current
  // approved_engineering_employers.csv, manual entries, and Intern-List
  // employers the user has explicitly approved via NEW_EMPLOYER_REVIEW.
  // Sourced-but-no-longer-in-the-CSV rows flip to false on the next CSV sync
  // rather than being deleted — never silently losing history.
  allowlisted Boolean @default(true)

  // Denormalized copy of the matching approved_engineering_employers.csv row,
  // refreshed on every CSV sync. Null for non-CSV sources.
  csvSector                 String?
  csvCareerDomain           String?
  csvEeCpeFit               String?
  csvVerificationStatus     String?
  csvVerificationBasis      String?
  csvVerifiedDate           DateTime?
  csvRecommendedSearchTerms String?
  csvCanonicalApplyRule     String?

  approvedAtsTenants ApprovedAtsTenant[]
  officialBoardPolls OfficialBoardPoll[]

  @@index([atsType])
  @@index([nextCheckAt])
  @@index([priority])
  @@index([allowlisted])
  @@index([atsConfigState])
  @@index([engineeringActivityTier])
}

// Milestone (source-security): the specific, evidenced link between one
// employer's OWN official careers page and one ATS tenant. A Greenhouse/
// Lever/Ashby/etc. URL is never trusted just because it uses a known ATS —
// this row only exists once verify.ts has actually confirmed the employer's
// own career portal links to this exact tenant.
model ApprovedAtsTenant {
  id                       String   @id @default(cuid())
  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  atsType                  String
  atsIdentifier            String // tenant slug/board id
  discoveredFromCareersUrl String
  evidence                 String? // JSON: what confirmed the link
  approvedAt               DateTime @default(now())

  @@unique([companyId, atsType, atsIdentifier])
}

// Cache of "which official job board does this employer actually use?".
//
// A fresh discovery signal names an employer that is very often NOT in the
// approved-employer CSV. Rather than dropping that internship, the fresh radar
// resolves the employer independently: it takes the DOMAIN THE SOURCE ITSELF
// PUBLISHED for the company (never a guessed one), crawls that domain's own
// careers page, and only accepts an ATS tenant the employer's own page links
// to. The outcome — positive or negative — is cached here so a five-minute
// radar cadence never re-crawls the same employer.
//
// This table is deliberately SEPARATE from `Company`: `Company` is the curated
// approved-employer registry that drives the scheduled sweep, and auto-resolved
// employers must not silently join it.
model EmployerBoardResolution {
  id String @id @default(cuid())

  /// Normalized company key (see normalizeCompanyKey) — the lookup identity.
  normalizedCompany String @unique
  /// Last raw company name seen from a source, for humans reading diagnostics.
  companyName       String

  /// Hostname the SOURCE published for this employer. Never inferred.
  companyDomain String?
  /// The employer page that produced the ATS evidence.
  careersUrl    String?
  atsType       String?
  atsIdentifier String?

  /// RESOLVED — a usable board config; UNRESOLVED — none found yet.
  state      String  @default("UNRESOLVED")
  /// One FreshSignalReason value explaining an UNRESOLVED state.
  reasonCode String?
  /// JSON: how the tenant was established (method, boardUrl, postingCount).
  evidence   String?

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// Negative results back off instead of being retried every radar tick.
  nextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, nextAttemptAt])
}

// Per-signal outcome of the fresh radar's official-resolution pipeline.
//
// The point of this table is that a fresh internship signal is NEVER silently
// dropped. Every signal the radar sees gets a row, and every row carries a
// CONCRETE reason code — not one generic "unresolved" bucket — plus a retry
// schedule, so an employer whose board was briefly unreachable is tried again
// instead of being lost.
model FreshSignalResolution {
  id String @id @default(cuid())

  /// Discovery surface the signal came from ("jobright", "intern-list", ...).
  signalSource String
  /// The source's own stable id for the posting.
  signalJobId  String

  company           String
  normalizedCompany String
  title             String
  location          String?

  sourcePostedAt   DateTime?
  sourceCapturedAt DateTime

  /// PENDING | RESOLVED | CLOSED | DUPLICATE | ABANDONED
  state        String  @default("PENDING")
  /// SIGNAL_SEEN | OFFICIAL_SEARCH_QUEUED | OFFICIAL_SEARCHING |
  /// OFFICIAL_RESOLVED | NO_MATCH_YET | TRANSIENT_FAILURE | PERMANENT_FAILURE
  workflowState String @default("SIGNAL_SEEN")
  /// A FreshSignalReason value. Null once state is RESOLVED.
  reasonCode   String?
  reasonDetail String?

  /// direct_official_url | source_original_post | employer_board — how the
  /// official destination was reached, once it was.
  resolutionPath String?
  resolvedUrl    String?
  resolvedJobId  String?
  /// Wall-clock milliseconds the successful resolution took.
  resolutionMs   Int?

  attempts      Int       @default(0)
  firstSeenAt   DateTime  @default(now())
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  @@unique([signalSource, signalJobId])
  @@index([state, nextAttemptAt])
  @@index([workflowState, nextAttemptAt])
  @@index([reasonCode])
  @@index([resolvedJobId])
  @@index([sourcePostedAt])
}

// An employer Intern List surfaced that isn't in the CSV allowlist. Held
// here — never auto-ingested as a Job — until the user explicitly approves
// its official domain once, per the strict discovery boundary.
model NewEmployerReview {
  id                String    @id @default(cuid())
  employerName      String    @unique
  discoveredFrom    String    @default("intern-list")
  guessedCareersUrl String?
  guessedDomain     String?
  sourceJobTitle    String?
  sourceJobUrl      String?
  status            String    @default("pending") // pending | approved | rejected
  createdAt         DateTime  @default(now())
  reviewedAt        DateTime?
}

// Fraud-protection quarantine (never shown as a normal job, never receives
// an autofilled/uploaded resume or personal data).
model SecurityQuarantineEntry {
  id         String   @id @default(cuid())
  jobId      String?
  reason     String // short machine label, e.g. "requests-payment"
  detail     String // human-readable explanation
  evidence   String? // JSON
  detectedAt DateTime @default(now())

  @@index([jobId])
}

// A question/answer pair the user has explicitly approved once, reused for
// identical repeated application questions across employers instead of
// stopping every single time — never applied to a DIFFERENT question, only
// an exact normalized match.
model ApprovedAnswer {
  id           String   @id @default(cuid())
  /// Null on rows that predate accounts; those stay readable and editable.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionText String
  answer       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per user, so two accounts can each save their own "Why this company?".
  // Legacy rows carry a null userId and remain unique among themselves.
  @@unique([userId, questionText])
  @@index([userId])
}

model Job {
  id                       String    @id @default(cuid())
  title                    String
  company                  String
  location                 String?
  postingDate              DateTime?
  internshipTerm           String? // e.g. Summer 2027, Fall 2026
  duration                 String? // e.g. "10 weeks", "3 months"
  url                      String? // the official application URL once known (manual entries: whatever the user typed)
  description              String
  jobDescriptionSourceUrl  String?
  jobDescriptionHash       String?
  jobDescriptionCapturedAt DateTime?
  jobResponsibilities      String? // JSON string array captured from the official posting
  jobQualifications        String? // JSON string array captured from the official posting
  /**
   * DEPRECATED — personal state on a shared row.
   * One person marking an internship Submitted changed it for everyone who
   * could see the posting. The tracker status now lives on
   * `UserJobState.applicationStatus`, and nothing reads this column.
   * It is still here because it holds the only copy of the original user’s
   * tracker state until `scripts/claim-legacy-user-data.ts` copies it into
   * their `UserJobState`. A follow-up migration drops it once that has run
   * and been verified.
   */
  status                   String    @default("DISCOVERED")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // --- Phase 2: automatic discovery & verification ---
  source        String? // "intern-list" | "greenhouse" | "lever" | "ashby" | "smartrecruiters" | "usajobs" | ... | null (manual)
  sourceJobId   String? // id from the source adapter, for dedup
  requisitionId String? // employer-assigned requisition id, when the ATS exposes one
  sourceUrl     String? // the aggregator listing URL (never auto-visited after ingest)
  workplaceType String? // Remote | Hybrid | On Site
  firstSeenAt   DateTime?
  lastSeenAt    DateTime?

  // --- Canonical source posting date (freshness ordering) ---
  // sourcePostedAt is THE field the default Jobs feed is ordered by: when the
  // EMPLOYER/source says the job was posted, stored as an absolute UTC instant.
  // It is written once at ingest and only replaced when a later sync supplies a
  // strictly more reliable date — rediscovering a job never makes it look new.
  // Legacy `postingDate` is kept untouched for filters and back-compatibility.
  sourcePostedAt         DateTime?
  // The source's own words ("38 minutes ago", "Posted Today"), preserved so an
  // uncertain date can be shown honestly instead of rendered as a fake instant.
  sourcePostedText       String?
  // EXACT | RELATIVE_PARSED | DATE_ONLY | UNKNOWN — see src/lib/sync/sourceDate.ts.
  sourceDateConfidence   String?
  // EMPLOYER_ATS_EXACT | EMPLOYER_ATS_DATE | EMPLOYER_JSON_LD |
  // TRUSTED_RADAR_EXACT | TRUSTED_RADAR_RELATIVE | INFERRED | UNKNOWN.
  sourceDateProvenance   String?
  // When the sync actually read the source. Relative dates are resolved against
  // THIS instant, once, at ingest — never recomputed at page load.
  sourceCapturedAt       DateTime?
  // Which sync run last saw this row, and where it appeared in that run's list.
  // Lower sourceRowIndex = higher in the source. Only used as a tiebreaker, and
  // only for the newest run, so an older sync can never outrank a newer one.
  sourceSyncRunId        String?
  sourceRowIndex         Int?
  // First time the official-first crawler itself observed this requisition.
  // Kept separate from legacy/radar firstSeenAt for clean pipeline SLOs.
  officialFirstSeenAt    DateTime?
  discoveryPipeline     String?
  lastVerifiedAt         DateTime? // = "verifiedAt": when verificationStatus was last (re)computed
  compensation           String? // raw text, e.g. "$20-$23/hr"
  // Unverified | Pending | VERIFIED_OFFICIAL_AT_LAST_CHECK | NeedsReview |
  // CLOSED_OR_UNVERIFIED | Closed | SecurityQuarantine
  // Only VERIFIED_OFFICIAL_AT_LAST_CHECK jobs appear on the main Jobs page
  // (Milestone 3); Pending/NeedsReview live in Quarantine; Closed/
  // CLOSED_OR_UNVERIFIED/SecurityQuarantine are excluded from both feeds.
  verificationStatus     String    @default("Unverified")
  // Single clean machine reason code for the CURRENT state (never a growing
  // concatenation). One of the VerificationReasonCode values in
  // src/lib/jobs/verificationModel.ts. verificationReason holds ONE clean
  // human message. Append-only per-attempt history lives in VerificationAttempt.
  reasonCode             String?
  verificationReason     String?
  verificationMethod     String? // e.g. "greenhouse-board-match" | "lever-board-match" | "manual-entry"
  officialEmployerDomain String? // hostname of the officialApplyUrl (`url` field), once verified
  evidence               String? // JSON: the specific checks that passed/failed during verification
  /// DEPRECATED, and for the same reason as `status`: a score is a statement
  /// about one person against this job. Lives on `UserJobState.matchScore`.
  matchScore             Int?
  /// DEPRECATED. Lives on `UserJobState.eligibilityStatus`.
  eligibilityStatus      String?

  // --- Strict source-security verification chain ---
  discoverySource          String? // "csv" | "intern-list" — which of the two allowed boundary sources this job came from
  atsType                  String? // greenhouse | lever | ashby | workday | icims | smartrecruiters | successfactors | taleo | unknown
  atsTenant                String? // the specific tenant/board id — only trusted once an ApprovedAtsTenant row confirms the employer's own page links here
  redirectChain            String? // JSON array of {url, status}[] followed while reaching the official application URL
  httpStatusAtVerification Int? // HTTP status of the final official page at last verification
  officialJobUrl           String? // the official JOB DESCRIPTION page (may differ from the apply URL)
  officialApplyUrl         String? // normalized HTTPS URL the application worker is allowed to navigate to

  // --- Canonical official-destination resolution ---
  // Legacy sourceUrl/officialApplyUrl/url remain for compatibility. New code
  // reads and writes these explicit fields so discovery attribution can never
  // be confused with the employer application destination.
  sourceListingUrl       String?
  officialApplicationUrl String?
  originalJobPostUrl     String?
  resolutionStatus       String    @default("OFFICIAL_URL_UNRESOLVED") // RESOLVED | OFFICIAL_URL_UNRESOLVED
  resolutionMethod       String?
  resolvedAt             DateTime?
  resolutionError        String?

  // --- Active-feed VISIBILITY (distinct from verificationStatus) ---
  // True when the job belongs in the main "Active Jobs" feed. Computed
  // centrally by computeActiveFeed() in src/lib/jobs/sourcePolicy.ts and set
  // on every write path. Trusted-aggregator listings (Jobright/Simplify/
  // Intern List) are active even while their official destination is still
  // "verification pending" — making a job visible never changes its
  // verificationStatus.
  activeFeed Boolean @default(false)

  // --- filter-support classification (heuristic, computed at ingest/verify time) ---
  disciplineTags           String? // JSON array, e.g. ["electrical","embedded"]
  sophomoreEligible        Boolean?
  graduationYears          String? // JSON array of ints mentioned in the posting
  sponsorship              String? // Yes | No | NotSure | Unknown
  citizenshipOrClearance   Boolean? // true if posting text mentions a citizenship/clearance requirement
  compMinHourly            Float?
  compMaxHourly            Float?
  season                   String? // Summer | Fall | Spring | Winter | Unknown
  distanceMilesFromClifton Float? // null when the location couldn't be geocoded locally

  userStates           UserJobState[]
  matchResults         MatchResult[]
  generatedDocuments   GeneratedDocument[]
  applicationRuns      ApplicationRun[]
  verificationAttempts VerificationAttempt[]
  initialAiMatchJobs   InitialAiMatchJob[]

  // --- Automatic AI scoring queue ---
  scoringState       String    @default("NOT_SCORED") // NOT_SCORED | QUEUED | SCORING | RETRYABLE_FAILED | SCORED | FAILED | STALE
  scoringPriority    Int       @default(1)
  scoringError       String?
  scoringQueuedAt    DateTime?
  scoringStartedAt   DateTime?
  scoringFinishedAt  DateTime?
  scoringHeartbeatAt DateTime?

  // --- Canonical internship classification (src/lib/sync/internshipClassifier.ts) ---
  // QUALIFYING_INTERNSHIP | NOT_AN_INTERNSHIP | UNCERTAIN_CLASSIFICATION |
  // CONFIRMED_CLOSED | PARSE_FAILED. Null on rows ingested before the
  // classifier existed (legacy Intern List records) — never treated as a
  // rejection, so nothing already visible disappears.
  classification       String?
  classificationReason String?

  // A posting is closed from board absence only after two consecutive
  // successful snapshots. Transient failures never increment this counter.
  consecutiveBoardMisses Int       @default(0)
  boardMissingSince      DateTime?
  closedAt               DateTime?

  @@index([source, sourceJobId])
  @@index([sourcePostedAt])
  @@index([sourceSyncRunId, sourceRowIndex])
  @@index([discoveryPipeline, officialFirstSeenAt])
  @@index([verificationStatus])
  @@index([activeFeed])
  @@index([scoringState])
  @@index([classification])
}

// One row per ATS ingestion run. Gives every sync an auditable record of what
// was discovered versus what was persisted, so a completeness gap is visible
// as data rather than inferred from logs.
model AtsSyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | success | error
  vendors    String // JSON array of ATS vendors included in this run

  employersChecked   Int @default(0)
  employersWithBoard Int @default(0)
  employersFailed    Int @default(0)

  rowsDiscovered Int @default(0)
  uniqueRows     Int @default(0)
  qualifying     Int @default(0)
  notInternship  Int @default(0)
  uncertain      Int @default(0)
  closed         Int @default(0)
  parseFailures  Int @default(0)

  inserted              Int @default(0)
  updated               Int @default(0)
  unchanged             Int @default(0)
  duplicatesPrevented   Int @default(0)
  persistenceFailures   Int @default(0)
  officialUrlsConfirmed Int @default(0)

  durationMs     Int     @default(0)
  errorMessage   String?
  // JSON: failure reasons grouped by sanitized code. Never contains full
  // descriptions, tokens, or cookies.
  failureSummary String?

  @@index([startedAt])
}

// One auditable result per official employer-board query. Provider-oriented
// rows power the coverage report and make adapter return-on-effort measurable.
model OfficialBoardPoll {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  companyName String
  provider    String
  startedAt   DateTime
  finishedAt  DateTime @default(now())
  status      String // success | not_modified | unsupported | error

  jobsScanned                 Int @default(0)
  totalAvailableJobs          Int @default(0)
  engineeringInternshipsFound Int @default(0)
  newJobs                     Int @default(0)
  updatedJobs                 Int @default(0)
  missingJobs                 Int @default(0)
  closedJobs                  Int @default(0)
  durationMs                  Int @default(0)
  errorCode                   String?
  configState                 String?
  paginationVerified          Boolean @default(false)
  fullJdJobs                  Int @default(0)
  exactTimestampJobs          Int @default(0)
  dateOnlyJobs                Int @default(0)
  relativeParsedJobs          Int @default(0)
  radarFallbackJobs           Int @default(0)
  unknownTimestampJobs        Int @default(0)

  @@index([provider, startedAt])
  @@index([companyId, startedAt])
  @@index([status, startedAt])
}

// Append-only history of every verification/re-verification attempt on a job.
// The CURRENT reason lives on Job.reasonCode/verificationReason as a single
// clean value; this table is where attempts accumulate — so re-verifying a
// job many times grows THIS table, never the displayed reason string.
model VerificationAttempt {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reasonCode  String // one VerificationReasonCode value
  status      String // the resulting verificationStatus
  message     String // one clean human message for this attempt
  httpStatus  Int?
  attemptedAt DateTime @default(now())

  @@index([jobId])
  @@index([attemptedAt])
}

model MatchResult {
  id                     String             @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                  String
  job                    Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eligibility            String // Pass | Fail | Unknown
  eligibilityReason      String
  score                  Int // 0-100
  explanation            String
  recommendation         String             @default("Consider") // Apply | Skip | Consider
  skillsSupported        String // JSON string array
  skillsNeedConfirmation String // JSON string array
  skillsToLearn          String // JSON string array
  skillsNeverAdd         String // JSON string array
  tailoringPreview       String? // JSON string array of grounded resume-bullet suggestions
  factsUsed              String // JSON string array of ResumeFact ids referenced
  origin                 String? // MANUAL | INITIAL_AUTO; null preserves legacy records unchanged
  createdAt              DateTime           @default(now())
  initialAiMatchJob      InitialAiMatchJob?

  @@index([userId])
  @@index([userId, jobId])
}

// Durable, idempotent work record for the one automatic match allowed when a
// genuinely new internship is persisted. Manual reruns never use this table.
model InitialAiMatchJob {
  id            String       @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchType     String       @default("INITIAL")
  state         String       @default("PENDING") // PENDING | RUNNING | SUCCEEDED | RETRYABLE_FAILED | PERMANENT_FAILED
  attemptCount  Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedAt      DateTime?
  lastErrorCode String?
  matchResultId String?      @unique
  matchResult   MatchResult? @relation(fields: [matchResultId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Per user: the automatic first score is one per person per job, not one
  // globally. A second applicant must not find the queue already "done".
  @@unique([userId, jobId, matchType])
  @@index([state, nextAttemptAt])
  @@index([userId])
}

// One row per sync run against a discovery source (e.g. Intern List).
model SyncLog {
  id               String    @id @default(cuid())
  source           String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String // running | success | error
  newJobsCount     Int       @default(0)
  updatedJobsCount Int       @default(0)
  errorMessage     String?
}

// Named, reusable filter presets for the Jobs page.
model SavedFilter {
  id         String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  filterJson String
  createdAt  DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

// Generic key/value app settings (search center/radius, scheduler pause
// state, application mode/threshold, etc.) — one flexible table instead of a
// growing pile of one-off singleton models.
model AppSetting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

// Milestone 6: one row per attempt to fill/submit an application. This is
// the durable record the worker pipeline reads/writes as it steps through
// the 13-step process, and what a paused/crashed/restarted server resumes
// from — never re-attempts a requisition that already has a "submitted" row.
model ApplicationRun {
  id                         String    @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId                     String?
  user                       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Non-null only while this run is queued, running, or paused. The unique
  // constraint is the durable duplicate-click guard: one job can have only
  // one active application run, even across web/worker process races.
  activeKey                  String?   @unique
  jobId                      String
  job                        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mode                       String // fill_only | auto_submit
  atsType                    String // greenhouse | lever | ashby | workday | smartrecruiters | icims | taleo | successfactors | unknown
  status                     String    @default("queued") // queued | running | needs_user_action | filled | submitted | failed | cancelled | superseded
  currentStep                String? // human-readable label of the pipeline step in progress/last attempted
  stageHistory               String? // JSON array of durable {stage, at, detail} transitions
  needsUserActionReason      String? // one of the documented stop reasons (captcha, mfa, ...)
  stoppedFieldLabel          String? // the exact form field label that triggered the stop, if any — lets the user supply + save an answer for reuse
  stoppedFieldType           String?
  stoppedFieldOptions        String? // JSON string array
  stoppedFieldStep           Int?
  stoppedFieldContext        String? // JSON: aria-label, placeholder, nearby text, page URL
  resumeDocumentId           String? // GeneratedDocument used for this attempt
  coverLetterDocumentId      String?
  // Document strategy chosen at queue time (see src/lib/documents/strategy.ts):
  // TAILORED | PARTIAL_TAILORING | MASTER_RESUME_FALLBACK |
  // EXISTING_APPROVED_DOCUMENT | NO_APPROVED_DOCUMENT. Separates resume
  // tailoring from autofill eligibility — an incomplete job description picks a
  // fallback strategy instead of blocking the run.
  documentStrategy           String?
  documentStrategyReason     String?
  jobDescriptionCompleteness String? // complete | partial | none
  matchScoreAtRun            Int? // denormalized MatchResult.score at the time this run started
  answers                    String? // JSON: every form question + answer actually submitted/filled, for the audit trail
  confirmationNumber         String?
  confirmationUrl            String?
  attemptNumber              Int       @default(1)
  attemptHistory             String? // JSON array of past attempt records
  errorCode                  String? // Machine error code (FORM_DESCRIPTION_INVALID, EXTENSION_DISCONNECTED, etc.)
  validationPath             String? // Path to invalid field if applicable (e.g. fields[3].options)
  protocolVersion            Int? // Protocol version exchanged
  schemaVersion              Int? // Form schema version exchanged
  tabRemainsOpen             Boolean   @default(true)
  screenshotPath             String? // saved on submit AND on needs_user_action, so the user can see exactly what happened
  browserLogPath             String?
  errorLog                   String?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([userId])
  @@index([userId, jobId])
}

// Milestone 8 (built now so Milestone 6's worker has somewhere to write):
// a permanent, append-only record of every AI decision and every automated
// action taken on a job — never edited or deleted, so "why did the system
// do X" always has a real, timestamped answer.
model AuditLogEntry {
  id        String   @id @default(cuid())
  /// Set on entries describing one person’s activity (an application, a
  /// generated document, a mailbox sync). Null on global discovery and
  /// verification events, which belong to no one.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  actor     String // "ai-match" | "verification" | "document-generation" | "application-agent" | "gmail-tracking" | "user"
  action    String // short machine-readable label, e.g. "eligibility-scored" | "verification-passed" | "application-submitted"
  detail    String // human-readable explanation of what happened and why
  metadata  String? // JSON: structured data relevant to the action (scores, ids, reasons)
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@index([userId])
}

// Milestone 7: the connected Gmail account, read-only. Singleton row (id is
// always "default"). Tokens are stored AES-256-GCM encrypted at rest (see
// src/lib/gmail/crypto.ts) — never logged, never written in plaintext.
// Scope is always gmail.readonly; this app never sends, deletes, archives,
// or modifies anything in the mailbox.
model GmailAccount {
  id                    String    @id @default(cuid())
  /// One connected mailbox per account. This was a singleton row keyed
  /// "default", which hosted means one person’s inbox answering for everyone.
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAddress          String
  encryptedRefreshToken String
  encryptedAccessToken  String?
  accessTokenExpiresAt  DateTime?
  lastSyncAt            DateTime?
  lastSyncHistoryId     String? // Gmail history id, for incremental sync
  connectedAt           DateTime  @default(now())
}

// One row per Gmail message the tracker has looked at and classified.
// Stores only what's needed to match/display — never the complete raw email
// body unless it's an assessment (where instructions are genuinely useful),
// per the "never log complete email bodies unless necessary" constraint.
model TrackedEmail {
  id             String   @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unique per user: two people can each receive the same broadcast message.
  gmailMessageId String
  threadId       String
  subject        String
  fromAddress    String
  snippet        String
  receivedAt     DateTime
  classification String // confirmation | assessment | interview | recruiter-message | info-request | rejection | offer | withdrawal | status-update | unknown
  matchedJobId   String?
  matchMethod    String? // company-name | job-title | requisition-id | ats-domain | thread-continuity | none
  processedAt    DateTime @default(now())

  @@unique([userId, gmailMessageId])
  @@index([classification])
  @@index([matchedJobId])
  @@index([userId])
}

// Milestone 7: extracted details for an assessment mentioned in a tracked
// email. The system NEVER takes, solves, or submits the assessment itself —
// this is purely a reminder/summary/checklist surface, per spec.
model AssessmentInboxEntry {
  id              String    @id @default(cuid())
  /// Null only until the one-time legacy claim assigns it. See
  /// scripts/claim-legacy-user-data.ts.
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String?
  sourceEmailId   String?
  company         String
  jobTitle        String?
  provider        String? // e.g. HackerRank, Codility, CodeSignal — null if not stated
  deadline        DateTime?
  duration        String? // e.g. "90 minutes" — raw text, never inferred
  link            String?
  instructions    String?
  legitimacyNotes String? // e.g. "Sender domain matches employer's official domain"
  createdAt       DateTime  @default(now())

  @@index([jobId])
  @@index([userId])
}

// Milestone 2: a business found via Google Places search near the user's
// chosen center. NEVER shown as an internship itself — only a staging record
// on the way to (maybe) becoming a full Company Watchlist entry once we've
// independently confirmed its official site and found a real careers page.
model NearbyFirm {
  id            String    @id @default(cuid())
  placeId       String    @unique
  name          String
  category      String
  address       String?
  latitude      Float?
  longitude     Float?
  distanceMiles Float?
  website       String?
  careersUrl    String?
  atsType       String?
  atsIdentifier String?
  companyId     String? // set once promoted to the Company Watchlist
  status        String    @default("discovered") // discovered | website_confirmed | careers_found | promoted | no_careers_found
  discoveredAt  DateTime  @default(now())
  lastCheckedAt DateTime?
}

// ---------------------------------------------------------------------------
// Internship Pilot accounts.
//
// This password protects the Internship Pilot account and nothing else. It is
// never an employer-site password: those live in the browser's password
// manager or in the extension's encrypted vault, and never in this database.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  /// Better Auth's canonical display name. Required by its user table, so it
  /// is defaulted rather than nullable; the migration backfills it from
  /// `displayName`.
  name          String   @default("")
  /// Whether the address has been proven. Account linking reads this: an
  /// unverified local account is never merged into an OAuth identity.
  emailVerified Boolean  @default(false)
  image         String?
  /**
   * Legacy scrypt hash, kept only so the credential migration is reversible.
   * Better Auth stores the credential in `Account.password`, and that row is
   * the one every sign-in reads. Nothing in the application reads this column
   * any more; it is not dropped because deleting the sole prior copy of a
   * credential to tidy a schema is not a trade worth making.
   */
  passwordHash  String?
  /// Superseded by `name`. Retained so nothing that still reads it breaks.
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Better Auth owns these two.
  authSessions Session[]
  accounts     Account[]

  /// Superseded by `authSessions`. See the model comment on `UserSession`.
  sessions UserSession[]

  profile                UserProfile?
  educations             Education[]
  experiences            Experience[]
  projects               Project[]
  applicationPreferences ApplicationPreferences?
  sensitivePreferences   SensitiveAnswerPreferences?
  savedAnswers           ApprovedAnswer[]

  // Everything below is this person's private data. Each relation cascades:
  // none of these rows means anything without the account that owns it.
  jobStates          UserJobState[]
  resumeFacts        ResumeFact[]
  resumeDocuments    ResumeDocument[]
  resumeBullets      ResumeBullet[]
  generatedDocuments GeneratedDocument[]
  companyFacts       CompanyRelationshipFact[]
  matchResults       MatchResult[]
  initialAiMatchJobs InitialAiMatchJob[]
  applicationRuns    ApplicationRun[]
  savedFilters       SavedFilter[]
  gmailAccounts      GmailAccount[]
  trackedEmails      TrackedEmail[]
  assessments        AssessmentInboxEntry[]
  settings           UserSetting[]
  extensionTokens    ExtensionToken[]
  auditLogEntries    AuditLogEntry[]
}

/**
 * Better Auth's session table.
 * The cookie carries `token`; this row is the server's copy. Better Auth owns
 * every write, which is the point of adopting it — session rotation, expiry and
 * revocation stop being this project's code to get right.
 */
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * One authentication method belonging to one user.
 * `providerId = "credential"` is the email/password row, whose `password`
 * column holds the scrypt hash. `providerId = "google"` is a linked Google
 * identity. A single human with both has ONE `User` row and two of these —
 * which is the whole reason linking is explicit rather than implicit.
 * Tokens here are provider tokens, never logged and never returned to the
 * browser: Better Auth marks them `returned: false`.
 */
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived tokens: email verification, password reset. Better Auth owns it.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/**
 * The pre-Better-Auth session table.
 * Nothing writes to it any more. It is kept, empty of meaning rather than
 * dropped, because dropping a table is the one migration step that cannot be
 * undone by re-running the migration — and it costs nothing to leave.
 */
model UserSession {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie value. A stolen database row cannot be replayed.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalFirstName   String?
  middleName       String?
  legalLastName    String?
  preferredName    String?
  applicationEmail String?
  alternateEmail   String?
  phone            String?
  phoneCountryCode String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?

  updatedAt DateTime @updatedAt
}

model Education {
  id     String  @id @default(cuid())
  /// Null in local single-user mode, where there is no account to own the row.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  school             String
  degree             String?
  major              String?
  minor              String?
  startMonth         String?
  startYear          String?
  graduationMonth    String?
  graduationYear     String?
  gpa                String?
  educationLevel     String?
  relevantCoursework String?
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Experience {
  id     String  @id @default(cuid())
  /// Null in local single-user mode, where there is no account to own the row.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employer          String
  title             String?
  location          String?
  startDate         String?
  endDate           String?
  currentlyEmployed Boolean  @default(false)
  /// JSON array of user-approved responsibility lines.
  responsibilities  String?
  /// JSON array of user-approved resume bullets.
  approvedBullets   String?
  sortOrder         Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Project {
  id     String  @id @default(cuid())
  /// Null in local single-user mode, where there is no account to own the row.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  startDate      String?
  endDate        String?
  /// JSON array of technologies.
  technologies   String?
  description    String?
  /// JSON array of user-approved skills evidenced by this project.
  approvedSkills String?
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model ApplicationPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every field is nullable on purpose. Null means "the user has not told us",
  // which the agent must treat as unanswerable rather than as a default.
  legallyAuthorizedToWork    Boolean?
  requiresSponsorshipNow     Boolean?
  mayRequireSponsorshipLater Boolean?
  willingToRelocate          Boolean?
  remotePreference           String?
  earliestStartDate          String?
  salaryPreference           String?
  hasDriversLicense          Boolean?
  securityClearanceStatus    String?
  usualJobSource             String?

  updatedAt DateTime @updatedAt
}

model SensitiveAnswerPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stored only when the user explicitly chose. Null means no choice was made,
  // and the agent must leave the question for them rather than answering it.
  gender              String?
  raceEthnicity       String?
  veteranStatus       String?
  disabilityStatus    String?
  pronouns            String?
  /// True when the user asked for demographic questions to be declined.
  declineDemographics Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Per-user state over shared rows.
// ---------------------------------------------------------------------------

/**
 * What one person has done about one internship.
 * The canonical `Job` is shared by every user — it is the employer's posting,
 * not anybody's application — so everything that is true of a *person and* a job
 * lives here instead: whether they saved it, hid it, applied, and what the AI
 * scored it for them.
 * The unique constraint is the whole model: exactly one state row per person per
 * job, so "have I applied to this?" has one answer and it is theirs.
 */
model UserJobState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// One of TRACKER_STATUSES in src/lib/statuses.ts.
  applicationStatus String  @default("DISCOVERED")
  saved             Boolean @default(false)
  hidden            Boolean @default(false)
  notes             String?

  /// Denormalized copy of this user's latest MatchResult for this job. A
  /// denormalized score is fine; a denormalized score on the shared Job row is
  /// not, which is the distinction this model exists to draw.
  matchScore        Int?
  eligibilityStatus String?
  matchedAt         DateTime?
  /// BASELINE is the deterministic local score available immediately;
  /// AI_REFINED is a completed model refinement over the same two inputs.
  scoreSource                String?
  /// Exact approved candidate-profile revision used for the displayed score.
  scoreProfileRevision       String?
  /// Exact canonical job scoring-input fingerprint used for the displayed score.
  scoreJobFingerprint        String?
  /// Explainable JSON rubric evidence for BASELINE; null for AI_REFINED.
  scoreExplanation           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([userId, applicationStatus])
  @@index([userId, scoreSource])
}

/**
 * Per-user settings.
 * `AppSetting` remains the global key/value table — scheduler pause state, sync
 * cursors, import status. Anything that is a *preference* rather than a fact
 * about the installation belongs here: the application mode, the auto-submit
 * threshold and allowlist, the nearby-search centre and radius.
 */
model UserSetting {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt

  @@id([userId, key])
  @@index([userId])
}

/**
 * A browser-extension credential belonging to exactly one account.
 * The extension used to authenticate with a single installation-wide secret out
 * of `AppSetting`, which in a hosted deployment means every extension presents
 * the same token and the server has no way to tell whose profile to answer with.
 * Only the SHA-256 digest is stored, so a copy of this table cannot be replayed,
 * and the plaintext is shown to the user exactly once at creation. The token
 * names its user; the extension never sends a user id, and one would not be
 * believed if it did.
 */
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token value.
  tokenHash  String    @unique
  /// First few characters, so the user can tell two tokens apart in the UI.
  tokenHint  String
  label      String    @default("Browser extension")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
