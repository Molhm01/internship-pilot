# ============================================================================
# Internship Pilot — environment template
#
# NAMES AND PLACEHOLDERS ONLY. Never commit a real secret to this file.
# `.env*` is gitignored; this template is the exception and must stay inert.
#
# DEPLOYMENT_ENVIRONMENT.md classifies every variable below: where it belongs
# (Vercel / local agent / development), whether it is required, and whether it
# is a secret. Read that first if you are configuring a deployment.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED EVERYWHERE
# ---------------------------------------------------------------------------

# Signs session cookies. Generate one per environment and never reuse it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Secret. Never NEXT_PUBLIC_ — in the browser this is a session-forgery kit.
BETTER_AUTH_SECRET=

# The canonical origin authentication runs on, including the OAuth callback.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, then to
# http://localhost:3000. Set it explicitly in production: VERCEL_URL is the
# per-deployment hostname, which is the wrong redirect target for a stable
# Google OAuth client.
BETTER_AUTH_URL="https://your-deployment.vercel.app"

# ---------------------------------------------------------------------------
# GOOGLE SIGN-IN — optional; both halves or neither
# ---------------------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Without both, "Continue with Google" is not offered at
# all, rather than rendering a button that fails at the redirect.
#
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL connection string. `npx prisma dev` starts a local Prisma Postgres
# and prints one; Vercel injects it when a Prisma Postgres store is connected.
# SQLite (`file:./dev.db`) is no longer supported — see prisma/README.md to
# import an existing dev.db.
DATABASE_URL="postgres://user:password@localhost:5432/internship_pilot"

# The public origin of THIS install. Used for metadataBase (Open Graph/Twitter
# absolute URLs) and as the default Gmail OAuth redirect host. In development
# it defaults to http://localhost:3000; a deployment must set it explicitly to
# its own HTTPS origin. NEXT_PUBLIC_ because the browser needs it too.
NEXT_PUBLIC_APP_URL="https://your-deployment.vercel.app"

# ---------------------------------------------------------------------------
# RUNTIME / STORAGE
# ---------------------------------------------------------------------------

# "local" or "cloud". Normally inferred: Vercel sets VERCEL=1 and is treated as
# cloud; anything else is local. Set it explicitly only for a self-hosted box
# that genuinely sits on the same machine as the user's Agent and Ollama.
# INTERNSHIP_PILOT_RUNTIME=

# "local" (filesystem, under data/) or "vercel-blob". Defaults to the runtime:
# local installs write to disk, cloud deployments write to Vercel Blob.
# DOCUMENT_STORAGE_DRIVER=

# Vercel Blob store token. Required whenever DOCUMENT_STORAGE_DRIVER resolves
# to vercel-blob. Vercel injects this automatically once a Blob store is
# connected to the project. Secret — never expose with a NEXT_PUBLIC_ prefix.
BLOB_READ_WRITE_TOKEN=""

# Postgres pool size per instance and connect timeout. Defaults 5 / 15000.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# LOCAL AI (Ollama) — runs on the USER'S computer, not on Vercel
#
# A deployed server has no route to the user's Ollama. It detects that and
# reports "Local AI offline" rather than failing against its own localhost.
# Setting these on Vercel does nothing useful unless OLLAMA_BASE_URL points at
# a non-loopback host the deployment can actually reach.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"
OLLAMA_VISION_MODEL="qwen3.5:9b"

# AI Match throughput. Concurrency is intentionally capped at 2; the worker
# automatically falls back to 1 when less than 8 GiB of system memory is free.
AI_MATCH_WORKER_CONCURRENCY=2
AI_MATCH_MODEL_TIMEOUT_MS=180000
AI_MATCH_MAX_DESCRIPTION_CHARS=12000
AI_MATCH_CONTEXT_TOKENS=8192
AI_MATCH_NUM_PREDICT=1200
AI_MATCH_KEEP_ALIVE=10m
AI_MATCH_MALFORMED_RETRIES=1

# ---------------------------------------------------------------------------
# LOCAL DOCUMENT COMPILATION — local development only
#
# Typst is a native binary invoked with child_process. It does not exist on a
# serverless host, so tailored-document generation is a local-only feature.
# ---------------------------------------------------------------------------
TYPST_BIN=

# Where generated PDFs and uploaded résumés are written when the storage driver
# is "local". Relative to the repository root.
# GENERATED_OUTPUT_DIR=data/generated
# RESUME_STORAGE_DIR=data/resumes

# ---------------------------------------------------------------------------
# GMAIL (optional) — requires your own Google Cloud OAuth client, see SETUP.md
# ---------------------------------------------------------------------------

# Secret used to encrypt Gmail OAuth tokens at rest in the database. Generate a
# random value per environment; a production deployment must NOT reuse the
# development one. Never sent to Google, never returned to the browser.
GMAIL_TOKEN_ENCRYPTION_KEY=""

GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Optional. Defaults to <NEXT_PUBLIC_APP_URL>/api/gmail/auth/callback. Set it
# only when the OAuth client is registered against a different domain. Whatever
# it resolves to must be listed verbatim as an authorized redirect URI in the
# Google Cloud console — Google matches it exactly.
GMAIL_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# EXTERNAL JOB SOURCES (optional)
# ---------------------------------------------------------------------------

# Free key for higher USAJOBS.gov rate limits and coverage.
# https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT=""

# Google Places key; without it the Nearby Firms page returns no automatic
# results. https://console.cloud.google.com/ — enable "Places API".
GOOGLE_PLACES_API_KEY=""

# ---------------------------------------------------------------------------
# LOCAL INTERNSHIP AGENT — the user's computer ONLY
#
# The Agent listens on IPv4 loopback. A deployed server's 127.0.0.1 is its own
# container, so these are meaningless on Vercel and the server refuses to try.
# From a hosted site the browser extension is the bridge to the Agent.
# ---------------------------------------------------------------------------

# Preferred: absolute path to the token file the sibling Internship-Agent repo
# generates on first run (local-data/agent-token.txt). Read at request time, so
# recreating the agent's data directory cannot leave this side on a stale
# secret — which silently 401s every document delivery.
INTERNSHIP_AGENT_TOKEN_FILE=

# Fallback shared secret, used only when the file above is unset or unreadable.
# Must match the value the agent accepts. Never expose it with a NEXT_PUBLIC_
# prefix and never return it to the browser.
INTERNSHIP_AGENT_TOKEN=

# Base URL of the local Internship-Agent server. Must be loopback http://.
INTERNSHIP_AGENT_BASE_URL=http://127.0.0.1:4317

# There is no installation-wide extension token any more. An extension token
# belongs to one account, is minted from Settings → Browser extension (or
# `npx tsx scripts/extension-token.ts --email you@example.com`), and is stored
# only as a SHA-256 digest. Nothing to configure here.

# ---------------------------------------------------------------------------
# LOCAL APPLICATION WORKER (Playwright) — local development only
# ---------------------------------------------------------------------------
# APPLICATION_BROWSER_PROFILE_DIR=data/browser-profile
# APPLICATION_OUTPUT_DIR=data/generated
# APPLICATION_WORKER_PORT=4318
# INTERNSHIP_PILOT_EXTENSION_DIR=extension/dist

# Which account the local Playwright worker fills applications for. Only
# needed when more than one account exists on this install; with exactly one,
# the worker uses it. The worker never guesses between several.
# APPLICATION_WORKER_USER_ID=
