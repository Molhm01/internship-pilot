# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It holds names and placeholders only, and it is how
# anyone configures a deployment, so it has to be in the repository.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local data — never commit: resume PII, generated documents, Gmail/OAuth
# tokens (encrypted at rest but still never belongs in source control), and
# the persistent browser profile (which can hold real logged-in ATS sessions)
/dev.db
/dev.db-journal
/dev.db.bak-*
/dev.db.bak2-*
/data/

# local supervisor lockfile (npm run local)
/.internship-pilot/

# local Prisma Postgres data directory created by `npx prisma dev`
/.prisma/


# Graphify knowledge graph — rebuildable, not source
graphify-out/
